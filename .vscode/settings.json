{
  /**
   * Editor
   */
  "editor.codeActionsOnSave": {
    "source.organizeImports": "always"
  },
  "editor.tabSize": 2,

  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  /**
   * Spell Checker
   */
  "cSpell.words": ["VITE"],
  /**
   * ESLint
   */
  "eslint.validate": ["javascript", "typescript", "typescriptreact"],
  "eslint.workingDirectories": ["./frontend", "./api"],
  "eslint.enable": true
}
